{
  "name": "snapsay",
  "version": "0.1.0",
  "private": true,
  "description": "SnapSay native macOS voice input assistant",
  "author": "SnapSay",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 14231",
    "build": "npm run typecheck && vite build && npm run native:mac",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npx tsc --noEmit",
    "native:mac": "bash scripts/build-native-macos.sh",
    "dist:mac": "npm run build",
    "setup:onnx:macos": "bash scripts/setup-onnx-asr-macos.sh",
    "watch-commit": "chokidar \"src/**/*\" -c \"git add . && git commit -m 'auto: code change detected' --allow-empty\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.0.15",
    "chokidar-cli": "^3.0.0",
    "jsdom": "^27.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  }
}
